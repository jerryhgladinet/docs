#: ../chapter7.rst:3
msgid "Folder Legends in Web Interface"
msgstr ""

#: ../chapter7.rst:5
msgid "There are many different folders in the web interface."
msgstr ""

#: ../chapter7.rst:7
msgid "Here is a list of them."
msgstr ""

#: ../chapter7.rst:9
msgid "**Mounted Storage**"
msgstr ""

#: ../chapter7.rst:15
msgid "This folder represents mounted/attached storage. For example, a mounted file server network share or a connected Amazon S3 bucket will look like this."
msgstr ""

#: ../chapter7.rst:17
msgid "**Sync From Remote**"
msgstr ""

#: ../chapter7.rst:23
msgid "This folder represents synchronization folders from remote PCs or Server Agents."
msgstr ""

#: ../chapter7.rst:25
msgid "**Received Shares**"
msgstr ""

#: ../chapter7.rst:31
msgid "This folder represents the root folder of all the shared files and folders from other users."
msgstr ""

#: ../chapter7.rst:33
msgid "**Regular Folder**"
msgstr ""

#: ../chapter7.rst:39
msgid "This folder represents a single shared folder received from other users."
msgstr ""

#: ../chapter7.rst:41
msgid "**Team Folder**"
msgstr ""

#: ../chapter7.rst:47
msgid "This folder represent a team folder that is published to users and viewed from the users who received the team folder."
msgstr ""

#: ../chapter7.rst:49
msgid "**Version Control**"
msgstr ""

#: ../chapter7.rst:55
msgid "Version folder represents folders that every files inside is under version control."
msgstr ""

#: ../chapter7.rst:59
msgid "If a folder doesn't have the version folder icon, doesn't mean it is not a version folder."
msgstr ""

#: ../chapter7.rst:61
msgid "As long as one of the parent folder is a version folder, everything inside is under version control."
msgstr ""

#: ../chapter7.rst:63
msgid "If the administrator setup the user as version control from the root, the team user may not see the version folder icon either when version control is on by default."
msgstr ""
