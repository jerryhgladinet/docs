msgstr "CIFS/SMB ネットワーク共有"

#: ../../chapter2.rst:50
msgid "DFS (Microsoft Distributed File System)"
msgstr "DFS (マイクロソフト分散ファイルシステム)"

#: ../../chapter2.rst:52
msgid "Cloud Storage Services"
msgstr "クラウドストレージサービス"

#: ../../chapter2.rst:54
