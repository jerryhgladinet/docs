msgstr "Yderligere politikker for rollen."

#: ../../chapter03.rst:470
msgid "ROLE MANAGER POLICIES"
msgstr "ROLLESTYRINGSREGLER"

#: ../../chapter03.rst:472
msgid "**Assigned Users/Groups**"
msgstr "**Tildelte brugere/grupper**"

