msgid "When this option is enabled, the guest user list will be shown in the recipient dropdown list."
msgstr ""

#: ../chapter03.rst:1446
msgid "**Show group list in sharing dialog**"
msgstr ""

#: ../chapter03.rst:1448
msgid "When this option is enabled, the group list will be shown in the recipient dropdown list."
msgstr ""

#: ../chapter03.rst:1451
