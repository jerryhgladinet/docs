msgstr ""

#: ../chapter03.rst:1707
msgid "OUTLOOK PLUGIN SETTINGS"
msgstr ""

#: ../chapter03.rst:1709
msgid "**Prompt conversion only when file is larger than n KB (0 - unlimited)**"
msgstr ""

#: ../chapter03.rst:1711
msgid "For smaller files, it may be as well to just use the native outlook attachment."
