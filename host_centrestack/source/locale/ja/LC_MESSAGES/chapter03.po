#: ../../chapter03.rst:232
msgid "APPLICATION MANAGER SETTINGS"
msgstr "アプリケーションマネージャー設定"

#: ../../chapter03.rst:235
msgid "Sharepoint Online"
msgstr "Sharepoint オンライン"

#: ../../chapter03.rst:240
msgid "SHAREPOINT ONLINE"
msgstr "SHAREPOINT オンライン"

#: ../../chapter03.rst:245
msgid "SHAREPOINT ONLINE SETTINGS"
